[autoexec]
@echo off
MOUNT c: c:\development\dosbox
set path=c:\tasm\bin;c:\bc\bin;c:\bc\lib
c:
cd c:\asm

delete bioserr.txt

@rem compilar em C
@rem ... -u  underscores nos extern
@rem ... -mt modelo memoria tiny (ds=cs)
@rem ... -c  compilar apenas
@rem
bcc -mt -c  -u test.cpp >> bioserr.txt

@rem compilar em ASM
@rem ... /W0  sem warnings
@rem ... /zn  sem informacao de debug
@rem
tasm BIOS.asm  /zn /os >> bioserr.txt
@rem pause

@rem ligar objetos
@rem tlink {objetos}, executavel, mapa, livrarias
@rem ... /x   criar executavel
@rem ... /c   simbolos sensivel a maiusculas
@rem ... /C   simbolos imp/exportados sensivel a maiusculas
@rem ... /P   compactar segmentos de codigo
@rem ... /k   nao dar o warning de "no stack"
@rem ... /m   mapa incluindo nomes publicos
@rem ... /s   mapa incluindo segmentos detalhado
@rem
@rem tlink /m /s /x test.obj BIOS.obj, BIOS.exe, BIOS.map >> bioserr.txt
tlink /m /s /x BIOS.obj, BIOS.exe, BIOS.map >> BIOSERR.txt
@rem pause

exit

[sdl]
fullscreen=false
fulldouble=false
fullresolution=original
windowresolution=original
output=surface
autolock=true
sensitivity=100
waitonerror=true
priority=higher,normal
mapperfile=mapper-0.74-3.map
usescancodes=true

[dosbox]
machine=svga_s3
captures=capture
memsize=16

[render]
frameskip=0
aspect=false
scaler=normal2x

[cpu]
core=auto
cputype=auto
cycles=100000
cycleup=10
cycledown=20

[dos]
xms=true
ems=true
umb=true
keyboardlayout=auto


