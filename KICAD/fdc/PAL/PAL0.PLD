Name       FDC_PAL0;
Date       1/3/22;
Revision   1;
Designer   Moreno;
Device     g16v8as; /* ATF16V8B - simple*/


Pin 1    = A3;        
Pin 2    = A4;     
Pin 3    = A5;      
Pin 4    = A6;
Pin 5    = A7;
Pin 6    = A8;
Pin 7    = A9;
Pin 8    = IOR_;
Pin 9    = IOW_;
Pin 11   = AEN;

/* saidas*/
Pin 13   = DATA_DIR;
Pin 12   = FDC_CS_;

/* usa se ~IOR em vez de ~IOW 
   porque se nao ativo
   fica para escrita (cpu tem controlo) 
   em vez do transceiver */
DATA_DIR   = IOR_;

FDC_CS_    = !(!AEN & A9&A8&A7&A6&A5&A4&(!A3));




