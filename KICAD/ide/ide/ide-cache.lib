F2 "" 100 200 50 H I C CNN
F3 "" 100 200 50 H I C CNN
DRAW
C 400 -150 50 0 1 0 N
C 550 -50 0 0 1 0 N
S 50 50 650 -350 0 1 0 N
P 2 0 1 0 0 -150 350 -150 N
P 2 0 1 0 50 -250 550 -250 N
P 2 0 1 0 50 -50 550 -50 N
P 2 0 1 0 400 -150 550 -50 N
X line1 1 -50 -50 100 R 50 50 1 1 P
X short 2 -50 -150 100 R 50 50 1 1 P
X line2 3 -50 -250 100 R 50 50 1 1 P
ENDDRAW
ENDDEF
